# 复制本文件为 .env 后填入你「自己」的密钥(★ 全部填你自己的,不要抄别人的)
#   复制方法: 把本文件重命名为 .env(或复制一份改名)
#   公众号后台: mp.weixin.qq.com → 设置与开发 → 基本配置
#   生图密钥:   火山引擎(即梦)控制台 → API 访问密钥;或阿里云百炼(通义万相)
#   千问 Key:   阿里云百炼控制台 → API-KEY(联网搜索/文案辅助,可后配)

# ── 微信公众号(必填,推送草稿箱要用) ──
WECHAT_APP_ID=填你的AppID
WECHAT_APP_SECRET=填你的AppSecret

# ── 生图后端(选一即可,配图/封面要用) ──
# 即梦/Seedream(火山引擎):申请后填 AK/SK
#   ★ 依赖版本必须锁定:装 volcengine==1.0.228,不要装 volcengine-python-sdk(5.x)!
#     pip install --index-url https://pypi.org/simple --only-binary :all: -r requirements.txt
JIMENG_ACCESS_KEY_ID=
JIMENG_SECRET_ACCESS_KEY=
SEEDREAM_ACCESS_KEY_ID=
SEEDREAM_SECRET_ACCESS_KEY=
# 通义万相(阿里云百炼):填 API-KEY 即可(与上面二选一;纯 HTTP,无需装任何 SDK)
QWEN_API_KEY=

# ── 可选:kfhot 康复资讯平台地址(供 kfinfo 取料;没有就留空,改用选题池) ──
# KFHOT_BASE_URL=http://<你的平台地址>:8000